{
  "name": "contextarmor",
  "displayName": "ContextArmor",
  "description": "AI Supply Chain & Model Deserialization Security Circuit Breaker",
  "version": "0.1.0",
  "publisher": "contextarmor",
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.90.0"
  },
  "bin": {
    "contextarmor": "./dist/cli.js"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.js",
    "eval": "node dist/eval.js",
    "test": "node --test tests/**/*.test.js"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:contextarmorSidebarView",
    "onLanguage:json",
    "onLanguage:pip-requirements",
    "onLanguage:python",
    "workspaceContains:**/package.json",
    "workspaceContains:**/requirements.txt",
    "workspaceContains:**/*.py"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextarmor-shield",
          "title": "ContextArmor",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "contextarmor-shield": [
        {
          "type": "webview",
          "id": "contextarmorSidebarView",
          "name": "Threat Radar"
        }
      ]
    },
    "commands": [
      {
        "command": "contextarmor.openDashboard",
        "title": "ContextArmor: Open Security Dashboard",
        "icon": "$(shield)"
      },
      {
        "command": "contextarmor.doctor",
        "title": "ContextArmor: Run Diagnostics & Doctor",
        "icon": "$(shield)"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
