{"name": "less-test-suite", "dist-tags": {"latest": "0.0.1"}, "time": {"created": "2026-06-28T00:54:28.937Z", "modified": "2026-06-29T16:18:23.725Z", "0.0.0": "2026-06-28T00:54:29.215Z", "0.0.1": "2026-06-29T16:18:23.458Z"}, "versions": {"0.0.0": {"name": "less-test-suite", "version": "0.0.0", "scripts": {}}, "0.0.1": {"name": "less-test-suite", "version": "0.0.1", "scripts": {"build": "node ./scripts/build.js", "clean": "run-p \"clean:*\"", "clean:dist": "del-cli dist", "dist": "run-p \"dist:*\"", "dist:npm": "release-it", "fix": "run-p --continue-on-error \"fix:*\"", "fix:eslint": "yarn lint:eslint --fix", "fix:markdown": "yarn lint:markdown --fix", "fix:package-json": "sort-package-json \"package.json\" \"packages/*/package.json\"", "fix:prettier": "prettier . --write", "lint": "run-p --continue-on-error \"lint:*\"", "lint:eslint": "eslint .", "lint:markdown": "markdownlint-cli2", "lint:package-json": "yarn run fix:package-json --check", "lint:prettier": "prettier . --check", "release": "run-s fix test dist", "test": "run-p test:js test:types", "test:js": "node --test", "test:types": "tsd", "test-coverage": "c8 yarn test", "update": "yarn build"}}}}