{"info": {"author": null, "author_email": "Barry Warsaw <barry@python.org>", "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Development Status :: 6 - Mature", "Intended Audience :: Developers", "License :: OSI Approved :: Apache Software License", "Operating System :: MacOS :: MacOS X", "Operating System :: Microsoft :: Windows", "Operating System :: POSIX", "Programming Language :: Python", "Programming Language :: Python :: 3", "Topic :: Software Development :: Libraries", "Topic :: Software Development :: Libraries :: Python Modules", "Topic :: Utilities"], "description": "======================\n @public and @private\n======================\n\nThis library provides two very simple decorators that document the public visibility of the names in\nyour module.  They keep your module's ``__all__`` in sync so you don't have to.\n\nAlso included is a function that you can put at the bottom of your module to simply infer all the\npublic names, and populate the ``__all__`` for you.\n\n\nInstallation\n============\n\n.. code-block:: console\n\n    $ pip install atpublic\n\nThe ``install`` extra additionally installs ``@public`` and ``@private`` into ``builtins``, so\nthey're always available without having to import them first:\n\n.. code-block:: console\n\n    $ pip install atpublic[install]\n\nNote that while the top-level module is named ``public``, the PyPI package is called ``atpublic``\ndue to a name conflict.  Do not install ``public``; that is a different package!\n\n\nAuthor\n======\n\n``public`` is Copyright (C) 2004-2026 Barry Warsaw <barry@python.org>\n\nLicensed under the terms of the Apache License Version 2.0.  See the LICENSE file for details.\n\n\nProject details\n===============\n\n * Project home: https://gitlab.com/flufl/public\n * Report bugs at: https://gitlab.com/flufl/public/-/work_items\n * Code hosting: https://gitlab.com/flufl/public.git\n * Documentation: https://public.readthedocs.io\n * PyPI: https://pypi.org/project/atpublic/\n", "description_content_type": "text/x-rst", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": null, "home_page": null, "keywords": "__all__, private, public", "license": "Apache-2.0", "license_expression": null, "license_files": ["LICENSE"], "maintainer": null, "maintainer_email": null, "name": "atpublic", "package_url": "https://pypi.org/project/atpublic/", "platform": null, "project_url": "https://pypi.org/project/atpublic/", "project_urls": {"Bug Tracker": "https://gitlab.com/flufl/public/-/work_items", "Documentation": "https://public.readthedocs.io", "Home Page": "https://public.readthedocs.io", "Source": "https://gitlab.com/flufl/public.git"}, "provides_extra": ["install"], "release_url": "https://pypi.org/project/atpublic/8.0.1/", "requires_dist": ["atpublic-install>=1.0.0; extra == \"install\""], "requires_python": ">=3.10", "summary": "Keep all y'all's __all__'s in sync", "version": "8.0.1", "yanked": false, "yanked_reason": null}, "releases": {"8.0.0": [{"comment_text": null, "core-metadata": {"sha256": "87759ac38a28b653763ab3acf0ca76240e42238376fdbfd87f1198e7688b36de"}, "digests": {"blake2b_256": "00356f69186fb0cb25e703003d04f10b65ed3c73e3989a4781b5e9294df7a019", "md5": "bb739023d93b463681c4dea6bfee0696", "sha256": "01eb44a6befc79752f1ca0a87b13a22f556b635a9f39bd93ea5bb9e45eec099e"}, "downloads": -1, "filename": "atpublic-8.0.0-py3-none-any.whl", "has_sig": false, "md5_digest": "bb739023d93b463681c4dea6bfee0696", "packagetype": "bdist_wheel", "python_version": "py3", "requires_python": ">=3.10", "size": 11103, "upload_time": "2026-09-18T23:54:07", "upload_time_iso_8601": "2026-09-18T23:54:07.846629Z", "url": "https://files.pythonhosted.org/packages/00/35/6f69186fb0cb25e703003d04f10b65ed3c73e3989a4781b5e9294df7a019/atpublic-8.0.0-py3-none-any.whl", "yanked": false, "yanked_reason": null}, {"comment_text": null, "core-metadata": false, "digests": {"blake2b_256": "fa7