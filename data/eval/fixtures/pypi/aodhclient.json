{"info": {"author": null, "author_email": "OpenStack <openstack-discuss@lists.openstack.org>", "bugtrack_url": null, "classifiers": ["Development Status :: 5 - Production/Stable", "Environment :: Console", "Environment :: OpenStack", "Intended Audience :: Information Technology", "Intended Audience :: System Administrators", "License :: OSI Approved :: Apache Software License", "Operating System :: POSIX :: Linux", "Programming Language :: Python", "Programming Language :: Python :: 3", "Programming Language :: Python :: 3 :: Only", "Programming Language :: Python :: 3.11", "Programming Language :: Python :: 3.12", "Programming Language :: Python :: 3.13", "Programming Language :: Python :: 3.14"], "description": "==========\naodhclient\n==========\n\n.. image:: https://governance.openstack.org/tc/badges/python-aodhclient.svg\n\n.. Change things from this point on\n\nPython bindings to the OpenStack Aodh API\n\nThis is a client for OpenStack Aodh API. There's a `Python API\n<https://docs.openstack.org/python-aodhclient/latest/api.html>`_ (the\naodhclient module), and a `command-line script\n<https://docs.openstack.org/python-aodhclient/latest/shell.html>`_ (installed\nas aodh). Each implements the entire OpenStack Aodh API.\n\n* Free software: Apache license\n* Release notes: https://releases.openstack.org/teams/telemetry.html\n* Documentation: https://docs.openstack.org/python-aodhclient/latest/\n* Source: https://opendev.org/openstack/python-aodhclient\n* Bugs: https://launchpad.net/python-aodhclient\n", "description_content_type": "text/x-rst", "docs_url": null, "download_url": null, "downloads": {"last_day": -1, "last_month": -1, "last_week": -1}, "dynamic": ["License-File", "Requires-Dist"], "home_page": null, "keywords": null, "license": "Apache-2.0", "license_expression": null, "license_files": ["LICENSE", "AUTHORS"], "maintainer": null, "maintainer_email": null, "name": "aodhclient", "package_url": "https://pypi.org/project/aodhclient/", "platform": null, "project_url": "https://pypi.org/project/aodhclient/", "project_urls": {"Homepage": "https://docs.openstack.org/python-aodhclient", "Repository": "https://opendev.org/openstack/python-aodhclient"}, "provides_extra": null, "release_url": "https://pypi.org/project/aodhclient/3.12.0/", "requires_dist": ["pbr>=2.0", "cliff>=1.17.0", "osc-lib>=1.0.1", "oslo.i18n>=1.5.0", "oslo.serialization>=1.4.0", "oslo.utils>=2.0.0", "osprofiler>=1.4.0", "keystoneauth1>=1.0.0", "pyparsing>3.0.0"], "requires_python": ">=3.11", "summary": "Python client library for Aodh", "version": "3.12.0", "yanked": false, "yanked_reason": null}, "releases": {"3.8.0": [{"comment_text": "", "core-metadata": {"sha256": "3aa3f648a2b179c5b4fd036ccdbeec68d2ef1d56c0a27ce524d48ec959912664"}, "digests": {"blake2b_256": "5a413cc5aafabdb93c3b1b100558f8d04df00ae9f9b6718e8cbbc4c289e4d8e2", "md5": "05503b39e5a3329c47c42b1d244aa629", "sha256": "7a6ff1ea1dd2901d1589f9deb0a0ce23fb564f0d642255e07c90638efe7798a7"}, "downloads": -1, "filename": "aodhclient-3.8.0-py3-none-any.whl", "has_sig": false, "md5_digest": "05503b39e5a3329c47c42b1d244aa629", "packagetype": "bdist_wheel", "python_version": "py3", "requires_python": ">=3.9", "size": 56071, "upload_time": "2025-05-15T13:13:00", "upload_time_iso_8601": "2025-05-15T13:13:00.496792Z", "url": "https://files.pythonhosted.org/packages/5a/41/3cc5aafabdb93c3b1b100558f8d04df00ae9f9b6718e8cbbc4c289e4d8e2/aodhclient-3.8.0-py3-none-any.whl", "yanked": false, "yanked_reason": null}, {"comment_text": "", "core-metadata": false, "digests": {"blake2b_256": "11b33e94df30ac6f1d7d9565b3cdc89b233487be6d76ae51e700274fa07d946f", "md5": "83890a2d79e3f594443e990ea7bdbca2", "sha256": "db9a4519a7baae07acca5d1d0a3cfb56f88eb2bb89c57b826508485878c25768"}, "downloads": -1, "filename": "aodhclient-3.8.0.tar.gz", "has_sig": false, "md5_digest": "83890a2d79e3f594443e990ea7bdbca2", "packagetype": "sdist", "python_version": "source", "requires_python": ">=3.9", "size": 54779, "upload_time": "2025-05-15