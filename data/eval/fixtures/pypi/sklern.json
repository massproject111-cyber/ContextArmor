d54e709ecc9de60efa59a9ffdd909ee8672cc35cfe59a3802a5bd/sklern-0.0.9.tar.gz", "yanked": false, "yanked_reason": null}]}, "urls": [{"comment_text": null, "core-metadata": {"sha256": "4051a444c0b35f103c47c02dcc39b6a9211e84fdb3b4b81f93512629ae8d2568"}, "digests": {"blake2b_256": "d58a933c5557064ef218c9bb60676db7a95fe41ac496771df52b72a0262f162d", "md5": "846d9479725b6a2e0a6fd41e68ff55b0", "sha256": "e5e8b9d5b9ee0cb93bf7f80a1c78a1e4abe4a0418f06e80681d501890e5111fd"}, "downloads": -1, "filename": "sklern-0.0.11-py3-none-any.whl", "has_sig": false, "md5_digest": "846d9479725b6a2e0a6fd41e68ff55b0", "packagetype": "bdist_wheel", "python_version": "py3", "requires_python": ">=3.8", "size": 25175, "upload_time": "2026-05-25T18:58:38", "upload_time_iso_8601": "2026-05-25T18:58:38.898146Z", "url": "https://files.pythonhosted.org/packages/d5/8a/933c5557064ef218c9bb60676db7a95fe41ac496771df52b72a0262f162d/sklern-0.0.11-py3-none-any.whl", "yanked": false, "yanked_reason": null}, {"comment_text": null, "core-metadata": false, "digests": {"blake2b_256": "e97ca9b12d9a354cfc581899eb2d389c33db97fe540aa2f77872db305d6e9780", "md5": "d353b20edbcbaefe8a73a41b4b6449d3", "sha256": "f8d1e2c7a084465deb02f6cc47cd199593ef6a0e0b1ad1f2923f509ffa4160ff"}, "downloads": -1, "filename": "sklern-0.0.11.tar.gz", "has_sig": false, "md5_digest": "d353b20edbcbaefe8a73a41b4b6449d3", "packagetype": "sdist", "python_version": "source", "requires_python": ">=3.8", "size": 24844, "upload_time": "2026-05-25T18:58:40", "upload_time_iso_8601": "2026-05-25T18:58:40.743765Z", "url": "https://files.pythonhosted.org/packages/e9/7c/a9b12d9a354cfc581899eb2d389c33db97fe540aa2f77872db305d6e9780/sklern-0.0.11.tar.gz", "yanked": false, "yanked_reason": null}], "vulnerabilities": [{"aliases": [], "details": "\n---\n_-= Per source details. Do not edit below this line.=-_\n\n## Source: amazon-inspector (1495d93dccc77a422f70d192ef4d8dcd53b0c990fff43e68bc2a0eca301e5d10)\nPackage name 'sklern' is a one-character deletion from the top-tier ML package 'sklearn', and its public API (linear_regression, logistic_regression, decision_tree, perceptron, mlp, etc.) mimics sklearn's surface but the functions do not implement ML \u2014 they print code strings. On `import sklern`, src/sklern/__init__.py loads src/sklern/ai_helper.py, which at module top level instantiates a Groq client with a hardcoded API key (`Groq(api_key=\"gsk_REDACTED_MALICIOUS_FIXTURE_KEY_00000000000000000000\")`). The exported `get1(prompt)` function \u2014 re-exported in `__all__` \u2014 sends the caller's prompt to api.groq.com using that hardcoded key, with no mechanism for the caller to override the destination or credential. PKG-INFO description is the placeholder 'Example PyPI package' and README references 'sample_package'. A developer who mistypes 'sklearn' as 'sklern' installs a package that (a) does not provide the ML functionality its API names suggest, (b) ships a live third-party credential that any installer can extract and abuse against api.groq.com, and (c) silently relays caller-supplied prompt data through the author's Groq account where it may be logged. The combination of name-confusion attack + credential distribution + silent-relay of caller data is the typosquat-with-payload pattern.\n", "fixed_in": [], "id": "MAL-2026-4768", "link": "https://osv.dev/vulnerability/MAL-2026-4768", "source": "osv", "summary": null, "withdrawn": null}]}