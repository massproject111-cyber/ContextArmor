i.org/project/avro/1.12.2/", "requires_dist": ["python-snappy; extra == \"snappy\"", "zstandard; extra == \"zstandard\""], "requires_python": ">=3.10", "summary": "Avro is a serialization and RPC framework.", "version": "1.12.2", "yanked": false, "yanked_reason": null}, "releases": {"1.9.0": [{"comment_text": "", "core-metadata": false, "digests": {"blake2b_256": "5ecd6e79070c42215fa7dc6c338fe82002aabdacf180d8e4d3b921ff0f8462a1", "md5": "f89afb035d41b1b51534f30511061b1b", "sha256": "5eace17f1740cfb4c6246de162ed2f8366647eb5a962b919189b0c8a9913c729"}, "downloads": -1, "filename": "avro-1.9.0.tar.gz", "has_sig": false, "md5_digest": "f89afb035d41b1b51534f30511061b1b", "packagetype": "sdist", "python_version": "source", "requires_python": null, "size": 46901, "upload_time": "2019-05-21T14:59:09", "upload_time_iso_8601": "2019-05-21T14:59:09.073657Z", "url": "https://files.pythonhosted.org/packages/5e/cd/6e79070c42215fa7dc6c338fe82002aabdacf180d8e4d3b921ff0f8462a1/avro-1.9.0.tar.gz", "yanked": false, "yanked_reason": null}], "1.9.1": [{"comment_text": "", "core-metadata": false, "digests": {"blake2b_256": "a19aa2c83f6105d975ec6680b2cab79b4e3bd51ae33f31c10debe8d2485c8f80", "md5": "ce735c524e539e0bcbab314f907ef910", "sha256": "9fc06bf0b91877b1b6afac8ad35d66d2e545be2b9b2820e5fba4e35b767bfb9a"}, "downloads": -1, "filename": "avro-1.9.1.tar.gz", "has_sig": false, "md5_digest": "ce735c524e539e0bcbab314f907ef910", "packagetype": "sdist", "python_version": "source", "requires_python": null, "size": 49076, "upload_time": "2019-09-02T07:40:38", "upload_time_iso_8601": "2019-09-02T07:40:38.301336Z", "url": "https://files.pythonhosted.org/packages/a1/9a/a2c83f6105d975ec6680b2cab79b4e3bd51ae33f31c10debe8d2485c8f80/avro-1.9.1.tar.gz", "yanked": false, "yanked_reason": null}], "1.9.2": [{"comment_text": "", "core-metadata": false, "digests": {"blake2b_256": "d70b592692ed26de33f35bf596780e6adb85c47e3e58061369bbc99125b902ec", "md5": "757917ff3f23327397bf455a10f6957a", "sha256": "4487f0e9